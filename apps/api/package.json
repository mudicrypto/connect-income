{
  "name": "@connect-income/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx --env-file=../../.env src/db/migrate-cli.ts",
    "seed": "tsx --env-file=../../.env src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "transition:legacy": "tsx --env-file=../../.env src/db/legacy-transition-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
