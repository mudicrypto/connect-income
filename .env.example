# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://connect:connect_dev@localhost:5432/connect_income
TEST_DATABASE_URL=postgres://connect:connect_dev@localhost:5432/connect_income_test
API_PORT=4000
# Enables the one-click development login and the simulated deposit faucet.
DEV_MODE=true
# Set to true only behind HTTPS.
COOKIE_SECURE=false
# Seconds between automatic SYNTHETIC market ticks + strategy engine runs (0 = off; drive manually from Admin > Strategies).
SIM_AUTOTICK_SECONDS=0
# Proxies allowed to set X-Forwarded-For (client IP for rate limits): "loopback" (default), a CIDR list, or false.
TRUST_PROXY=loopback
